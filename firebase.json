{
  "hosting": [
    {
      "target": "production",
      "public": "firebase-hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/workspace",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/workspace/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/workspaces",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/workspaces/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/admin/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/login",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/request-access",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/privacy",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/terms",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/start",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/chat",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/organizations",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/organizations/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/docs",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/docs/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/features/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/how-it-works",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        },
        {
          "source": "/team",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=60"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "papertrend-web-production",
            "region": "asia-southeast1"
          }
        }
      ]
    },
