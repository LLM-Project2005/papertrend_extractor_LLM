# Public frontend config
NEXT_PUBLIC_SITE_URL="https://your-vercel-preview-or-production-domain.example"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="set-in-vercel-env"
NEXT_PUBLIC_AUTH_PROVIDER="supabase"
NEXT_PUBLIC_FIREBASE_API_KEY="set-after-firebase-setup"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="set-after-firebase-setup"

# Phase 1 migration switches.
# Keep Supabase as default until Cloud SQL/GCS paths are explicitly enabled.
INFRA_PROVIDER="supabase"
DATABASE_PROVIDER="supabase"
REPOSITORY_CHAT_V2_ENABLED="true"
REPOSITORY_HYBRID_RETRIEVAL_ENABLED="false"
REPOSITORY_EMBEDDING_MODEL="openai/text-embedding-3-small"
REPOSITORY_EMBEDDING_DIMENSIONS="1536"
REPOSITORY_EMBEDDING_BATCH_SIZE="24"
REPOSITORY_CHAT_ASYNC_PAPER_THRESHOLD="80"
REPOSITORY_CHAT_TASKS_QUEUE=""
STORAGE_PROVIDER="supabase"

# Supabase remains the auth and default data provider in Phase 1.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="set-in-vercel-env"

# Phase 4 identity migration. Keep Supabase live until the Firebase mapping
# and cross-user authorization tests have passed in staging.
AUTH_PROVIDER="supabase"
FIREBASE_PROJECT_ID="set-in-secret-manager"
FIREBASE_CLIENT_EMAIL="set-in-secret-manager"
FIREBASE_PRIVATE_KEY="set-in-secret-manager"
FIREBASE_CHECK_REVOKED="true"

# Google Cloud resource names for Phase 1 staging.
GOOGLE_CLOUD_PROJECT_ID="your-google-cloud-project-id"
GOOGLE_CLOUD_REGION="asia-southeast1"
GCS_UPLOAD_BUCKET="papertrend-uploads-staging"
CLOUD_SQL_INSTANCE_CONNECTION_NAME="research-trend-analysis:asia-southeast1:papertrend-pg"
GOOGLE_SERVICE_ACCOUNT_EMAIL="papertrend-app-runtime@research-trend-analysis.iam.gserviceaccount.com"
DATABASE_URL="postgresql://papertrend_app:password@localhost:5432/papertrend"

# Worker and model services
PYTHON_NODE_SERVICE_URL="https://your-cloud-run-service-url"
WORKER_SERVICE_URL="https://your-cloud-run-service-url"
WORKER_WEBHOOK_SECRET="set-in-vercel-env"
OPENAI_API_KEY="set-in-vercel-env"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="google/gemini-3.1-flash-lite"

# Optional Google integrations
GOOGLE_CLIENT_ID="set-in-google-cloud-oauth"
GOOGLE_CLIENT_SECRET="set-in-vercel-env"
GOOGLE_DRIVE_REDIRECT_URI="https://your-domain.example/api/integrations/google-drive/callback"

# Safety controls
APP_ALLOWED_ORIGINS="https://your-domain.example"
LOGIN_RATE_LIMIT_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
AI_DAILY_MESSAGE_LIMIT="100"
AI_DAILY_DEEP_RESEARCH_LIMIT="10"
MAX_UPLOAD_BYTES="26214400"
MAX_PDF_PAGES="80"

# Worker-side publication-year fallback configuration.
PAPER_YEAR_WEB_LOOKUP_ENABLED="true"
CROSSREF_MAILTO=""
