{
  "name": "eil-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "auth:parity": "tsx scripts/auth-parity-smoke.ts",
    "test:repository-chat": "tsx --test --test-force-exit tests/*.test.ts",
    "test:repository-chat:live": "tsx scripts/repository-chat-live-eval.ts",
    "test:repository-chat:v2-planner-live": "tsx scripts/repository-chat-v2-planner-live.ts",
    "test:repository-chat:cloudsql": "tsx scripts/repository-chat-cloudsql-live.ts",
    "repository-memory:backfill": "tsx scripts/backfill-repository-memory.ts",
    "repository-memory:verify": "tsx scripts/verify-repository-memory.ts",
    "import-csv": "npx tsx scripts/import-csv.ts",
    "sync-supabase": "npx tsx scripts/import-csv.ts",
